---
import LogoBrand from '../components/LogoBrand.astro';
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <style>
    @font-face {
      font-family: 'Syne';
      font-weight: 700;
      font-style: normal;
      src: url('/assets/Syne-Bold.ttf') format('truetype');
      font-display: block;
    }
  </style>
  <style>
    :root { --amber: #c8922a; --display: 'Syne', sans-serif; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      width: 800px;
      height: 800px;
      background: #f4f1ec;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>
  <LogoBrand size={32} color="#1a1a1a" />
</body>
</html>
