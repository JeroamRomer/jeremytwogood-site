---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Reel from '../components/Reel.astro';
import Footer from '../components/Footer.astro';
import reelIndex from '../data/reel-index.json';
import profile from '../data/profile.json';

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Demo Sizzle · Twogood Productions',
  description:
    '40-second demo sizzle reel by Jeremy Twogood: editing, motion graphics, and production work.',
  contentUrl: reelIndex.reel_url,
  embedUrl: `https://www.youtube.com/embed/${reelIndex.reel_youtube_id}`,
  thumbnailUrl: `https://i.ytimg.com/vi/${reelIndex.reel_youtube_id}/hqdefault.jpg`,
  duration: 'PT40S',
  uploadDate: '2020-02-09',
  creator: {
    '@type': 'Person',
    name: profile.name,
    url: profile.website,
  },
};
---
<BaseLayout
  title={`Reel · ${profile.name}`}
  description="40-second demo sizzle reel: editing, motion graphics, and production work."
  pageType="reel"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema, null, 2)} />
  </Fragment>
  <Nav />
  <main>
    <Reel />
  </main>
  <Footer />
</BaseLayout>
