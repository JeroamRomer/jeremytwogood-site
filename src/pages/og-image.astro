---
// OG image export, screenshot at 1200×630
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1200" />
  <style>
    @font-face {
      font-family: 'Syne';
      src: url('/assets/Syne-Bold.ttf') format('truetype');
      font-weight: 700;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 1200px;
      height: 630px;
      overflow: hidden;
      background: #f4f1ec;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 51px;
      position: relative;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 72px;
      letter-spacing: -0.01em;
      color: #1a1a1a;
      white-space: nowrap;
      line-height: 1;
    }
    .brand-mark {
      width: 123px;
      height: 123px;
      flex-shrink: 0;
      position: relative;
    }
    .brand-mark svg {
      display: block;
      width: 100%;
      height: 100%;
      transform: translate(36px, -21px);
    }
    .name {
      position: relative;
      display: inline-block;
    }
    /* Line: full width, static (no animation for screenshot), gaps set by JS */
    .name::after {
      content: '';
      position: absolute;
      left: -77px;
      right: 0;
      bottom: 15px;
      height: 10px;
      background: linear-gradient(
        to right,
        #1a1a1a 0%,
        #1a1a1a var(--ys, 42%),
        transparent var(--ys, 42%),
        transparent var(--ye, 46%),
        #1a1a1a var(--ye, 46%),
        #1a1a1a var(--gs, 66%),
        transparent var(--gs, 66%),
        transparent var(--ge, 70%),
        #1a1a1a var(--ge, 70%)
      );
    }
    .dot { color: #c8922a; }
  </style>
</head>
<body>
  <div class="logo">
    <span class="brand-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="11" stroke="#1a1a1a"/>
        <circle cx="12" cy="12" r="2.6" fill="#c8922a" stroke="none"/>
        <circle cx="12" cy="5"  r="2" fill="#1a1a1a" stroke="none"/>
        <circle cx="19" cy="12" r="2" fill="#1a1a1a" stroke="none"/>
        <circle cx="12" cy="19" r="2" fill="#1a1a1a" stroke="none"/>
        <circle cx="5"  cy="12" r="2" fill="#1a1a1a" stroke="none"/>
      </svg>
    </span>
    <span class="name" id="og-name">Jerem<span class="gap-y">y</span> Two<span class="gap-g">g</span>ood<span class="dot">.</span></span>
  </div>

  <script>
    document.fonts.ready.then(function() {
      var name = document.getElementById('og-name');
      var gapY = name.querySelector('.gap-y');
      var gapG = name.querySelector('.gap-g');
      var nr = name.getBoundingClientRect();
      var overhang = 77;
      var totalW = nr.width + overhang;
      function pct(el, side) {
        var r = el.getBoundingClientRect();
        var px = (side === 'left' ? r.left : r.right) - nr.left + overhang;
        return (Math.max(0, px) / totalW * 100).toFixed(1) + '%';
      }
      var ys = pct(gapY, 'left');
      var ye = pct(gapY, 'right');
      var gs = pct(gapG, 'left');
      var ge = pct(gapG, 'right');
      name.style.setProperty('--ys', ys);
      name.style.setProperty('--ye', ye);
      name.style.setProperty('--gs', gs);
      name.style.setProperty('--ge', ge);
      document.body.setAttribute('data-ready', 'true');
    });
  </script>
</body>
</html>
