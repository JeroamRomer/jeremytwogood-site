---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoBrand from '../components/LogoBrand.astro';
---
<BaseLayout title="Logo Preview · Twogood Productions">
  <main style="min-height:100vh;background:#f4f1ec;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:64px;padding:80px 40px;">

    <!-- On light background -->
    <div style="display:flex;flex-direction:column;gap:40px;align-items:center">
      <p style="font-family:'Barlow', sans-serif;font-size:11px;line-height:1.55;letter-spacing:.2em;text-transform:uppercase;color:#6b6b63">On Light</p>
      <LogoBrand size={56} />
      <LogoBrand size={40} />
      <LogoBrand size={28} />
    </div>

    <!-- On dark background -->
    <div style="background:#111111;padding:64px 80px;border-radius:4px;display:flex;flex-direction:column;gap:40px;align-items:center">
      <p style="font-family:'Barlow', sans-serif;font-size:11px;line-height:1.55;letter-spacing:.2em;text-transform:uppercase;color:#888880">On Dark</p>
      <LogoBrand size={56} color="#e8e4dc" />
      <LogoBrand size={40} color="#e8e4dc" />
      <LogoBrand size={28} color="#e8e4dc" />
    </div>

  </main>
</BaseLayout>
