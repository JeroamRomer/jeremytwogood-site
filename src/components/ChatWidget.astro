---
// Floating "chat with my portfolio" widget. Mounted once in BaseLayout, so it
// appears site-wide. Streams answers from POST /api/chat (Anthropic Haiku),
// grounded in Jeremy's site data. Read-only Q&A (phase 1).
const STARTERS = [
  "What's your colour-grading experience?",
  'What AI tools have you built?',
  'Who have you worked with?',
  'Are you available for work?',
];
---
<div class="cw" data-chat-widget>
  <button class="cw__trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="cw-panel" aria-label="Ask about my work">
    <span class="cw__trigger-label cw__trigger-label--full">Ask about my work</span>
    <span class="cw__trigger-label cw__trigger-label--short">Ask</span>
  </button>

  <section id="cw-panel" class="cw__panel" role="dialog" aria-label="Ask about Jeremy Twogood's work" hidden>
    <header class="cw__head">
      <span class="cw__title">Ask about my work</span>
      <button class="cw__close" type="button" aria-label="Close chat">&times;</button>
    </header>

    <div class="cw__chips" data-cw-chips>
      {STARTERS.map((q) => (
        <button class="cw__chip" type="button" data-cw-starter={q}>{q}</button>
      ))}
    </div>

    <div class="cw__msgs" data-cw-msgs aria-live="polite" aria-atomic="false"></div>

    <form class="cw__form" data-cw-form>
      <input
        class="cw__input"
        type="text"
        name="message"
        autocomplete="off"
        placeholder="Ask anything about Jeremy…"
        aria-label="Your question"
        data-cw-input
      />
      <button class="cw__send" type="submit" aria-label="Send" data-cw-send>&#8593;</button>
    </form>

    <p class="cw__foot">Answers from Jeremy's site data · may be imperfect</p>
  </section>
</div>

<style>
  .cw{ font-family:var(--font-ui); }

  .cw__trigger{
    position:fixed; top:0; right:0; z-index:900;
    display:flex; align-items:center; justify-content:center; height:var(--bar-h); padding:0 16px;
    background:var(--panel-head); color:var(--muted); border:0; border-left:1px solid var(--hair);
    font:500 13px/1 var(--font-ui); cursor:pointer; transition:color .15s, background-color .15s;
  }
  .cw__trigger:hover{ color:var(--text); background:var(--lane); }
  .cw__trigger:focus-visible{ outline:2px solid var(--mango); outline-offset:-2px; }
  .cw[data-open] .cw__trigger{ color:var(--text); background:var(--lane); }
  .cw__trigger-label--short{ display:none; }

  .cw__panel{
    position:fixed; top:var(--bar-h); right:0; z-index:901;
    width:380px; max-width:calc(100vw - 32px); max-height:calc(100svh - var(--bar-h) - 24px);
    display:flex; flex-direction:column; overflow:hidden;
    background:var(--panel); color:var(--text); border:1px solid var(--hair-strong); border-top:0;
  }
  .cw__panel[hidden]{ display:none; }

  .cw__head{ display:flex; align-items:center; gap:10px; min-height:var(--pane-head-h); padding:0 6px 0 14px; background:var(--panel-head); border-bottom:1px solid var(--hair); }
  .cw__title{ font-weight:600; font-size:12px; letter-spacing:.02em; text-transform:uppercase; color:var(--muted); }
  .cw__close{ margin-left:auto; width:32px; height:32px; padding:0; background:none; border:0; color:var(--muted); font-size:20px; line-height:1; cursor:pointer; }
  .cw__close:hover{ color:var(--text); background:var(--lane); }
  .cw__close:focus-visible{ outline:2px solid var(--mango); outline-offset:-2px; }

  .cw__chips{ display:flex; flex-direction:column; border-bottom:1px solid var(--hair); }
  .cw__chips[hidden]{ display:none; }
  .cw__chip{ padding:9px 14px; text-align:left; font:500 14px/1.35 var(--font-ui); color:var(--text); background:none; border:0; border-top:1px solid var(--hair); cursor:pointer; }
  .cw__chip:first-child{ border-top:0; }
  .cw__chip:hover{ background:var(--lane); }
  .cw__chip:focus-visible{ outline:2px solid var(--mango); outline-offset:-2px; }

  .cw__msgs{ flex:1 1 auto; min-height:60px; overflow-y:auto; padding:12px 14px; display:flex; flex-direction:column; gap:12px; }
  .cw__msgs:empty{ display:none; }
  /* Bubbles and the caret are appended by the script after hydration, so they
     never carry Astro's scoping attribute. Hang these off the scoped
     .cw__msgs container with :global() so the rules still reach them. */
  .cw__msgs :global(.cw__bubble){ max-width:90%; font-size:14px; line-height:1.55; white-space:pre-wrap; overflow-wrap:anywhere; }
  .cw__msgs :global(.cw__bubble--user){ align-self:flex-end; padding:8px 12px; background:var(--lane-alt); border:1px solid var(--hair-strong); border-radius:2px; }
  .cw__msgs :global(.cw__bubble--bot){ align-self:flex-start; }
  .cw__msgs :global(.cw__bubble--error){ align-self:flex-start; color:var(--clip-offline-ink); font-size:13px; }
  .cw__msgs :global(.cw__caret){ display:inline-block; width:7px; height:15px; margin-left:1px; vertical-align:-2px; background:var(--mango); animation:cw-blink 1s steps(2) infinite; }

  .cw__form{ display:flex; align-items:center; gap:8px; margin:0; padding:8px; border-top:1px solid var(--hair); }
  .cw__form:focus-within{ box-shadow:inset 0 2px 0 var(--mango); }
  .cw__input{ flex:1 1 auto; min-width:0; padding:8px 10px; font:400 16px/1.3 var(--font-ui); color:var(--text); background:var(--lane); border:1px solid var(--hair); outline:none; }
  .cw__input::placeholder{ color:var(--dim); }
  .cw__send{ flex:0 0 auto; width:36px; height:36px; display:grid; place-items:center; background:var(--mango); color:var(--mango-ink); border:0; font-size:16px; font-weight:700; cursor:pointer; }
  .cw__send:disabled{ opacity:.45; cursor:default; }
  .cw__send:focus-visible{ outline:2px solid var(--text); outline-offset:2px; }

  .cw__foot{ margin:0; padding:0 14px 10px; font-size:11px; color:var(--dim); }

  @keyframes cw-blink{ 50%{ opacity:0; } }

  @media (max-width: 760px){
    .cw__trigger{ padding:0 12px; }
    .cw__trigger-label--full{ display:none; }
    .cw__trigger-label--short{ display:inline; }
    .cw__panel{ top:calc(var(--bar-h) + 41px); max-height:calc(100svh - var(--bar-h) - 41px - 12px); }
  }
  @media (max-width: 560px){
    .cw__panel{ right:0; left:0; width:100%; max-width:100%; border-left:0; border-right:0; }
  }
  @media (prefers-reduced-motion: reduce){
    .cw__trigger{ transition:none; }
    /* Same .cw__msgs :global() prefix as the base rule, so specificity ties
       and this override actually wins the cascade instead of losing to it. */
    .cw__msgs :global(.cw__caret){ animation:none; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-chat-widget]') as HTMLElement | null;
    if (!root) return;
    var trigger = root.querySelector('.cw__trigger') as HTMLButtonElement;
    var panel = root.querySelector('#cw-panel') as HTMLElement;
    var closeBtn = root.querySelector('.cw__close') as HTMLButtonElement;
    var chips = root.querySelector('[data-cw-chips]') as HTMLElement;
    var msgs = root.querySelector('[data-cw-msgs]') as HTMLElement;
    var form = root.querySelector('[data-cw-form]') as HTMLFormElement;
    var input = root.querySelector('[data-cw-input]') as HTMLInputElement;
    var sendBtn = root.querySelector('[data-cw-send]') as HTMLButtonElement;

    type Msg = { role: 'user' | 'assistant'; content: string };
    var history: Msg[] = [];
    var busy = false;
    var trackedOpen = false;
    var trackedFirst = false;

    function track(name: string) {
      try { (window as any).va && (window as any).va('event', { name: name }); } catch (e) { /* analytics optional */ }
    }

    // The model is asked for plain text but occasionally slips Markdown into
    // structured readbacks. Bubbles render textContent, so strip it for display.
    function clean(s: string): string {
      return s
        .replace(/\*\*(.+?)\*\*/g, '$1')                 // **bold**
        .replace(/__(.+?)__/g, '$1')                     // __bold__
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1 ($2)')  // [text](url) -> text (url)
        .replace(/`([^`]+)`/g, '$1')                     // `code`
        .replace(/^#{1,6}\s+/gm, '')                     // # headings
        .replace(/^\s*[-*+]\s+/gm, '• ');           // - bullets -> •
    }

    function open() {
      panel.hidden = false;
      root!.setAttribute('data-open', '');
      trigger.setAttribute('aria-expanded', 'true');
      input.focus();
      document.addEventListener('keydown', onKey);
      if (!trackedOpen) { trackedOpen = true; track('chat_opened'); }
    }

    function close() {
      panel.hidden = true;
      root!.removeAttribute('data-open');
      trigger.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKey);
      trigger.focus();
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') close();
    }

    function addBubble(cls: string, text: string): HTMLDivElement {
      var el = document.createElement('div');
      el.className = 'cw__bubble ' + cls;
      el.textContent = text;
      msgs.appendChild(el);
      msgs.scrollTop = msgs.scrollHeight;
      return el;
    }

    function setBusy(state: boolean) {
      busy = state;
      input.disabled = state;
      sendBtn.disabled = state;
    }

    async function ask(question: string) {
      if (busy) return;
      var text = question.trim();
      if (!text) return;

      if (chips) chips.hidden = true;
      if (!trackedFirst) { trackedFirst = true; track('chat_first_message'); }

      history.push({ role: 'user', content: text });
      addBubble('cw__bubble--user', text);
      input.value = '';
      setBusy(true);

      var bot = addBubble('cw__bubble--bot', '');
      var caret = document.createElement('span');
      caret.className = 'cw__caret';
      bot.appendChild(caret);
      var answer = '';

      try {
        var res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        if (!res.ok || !res.body) {
          var info = await res.json().catch(function () { return { error: 'Something went wrong.' }; });
          bot.remove();
          addBubble('cw__bubble--error', info.error || 'Something went wrong.');
          setBusy(false);
          input.focus();
          return;
        }

        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var buffer = '';

        while (true) {
          var chunk = await reader.read();
          if (chunk.done) break;
          buffer += decoder.decode(chunk.value, { stream: true });
          var parts = buffer.split('\n\n');
          buffer = parts.pop() || '';
          for (var i = 0; i < parts.length; i++) {
            var line = parts[i].trim();
            if (line.indexOf('data: ') !== 0) continue;
            var payload = line.slice(6);
            if (payload === '[DONE]') continue;
            try {
              var obj = JSON.parse(payload);
              if (obj.text) { answer += obj.text; bot.textContent = clean(answer); bot.appendChild(caret); }
              else if (obj.error) { answer += (answer ? '\n\n' : '') + obj.error; bot.textContent = clean(answer); }
            } catch (e) { /* ignore malformed frame */ }
            msgs.scrollTop = msgs.scrollHeight;
          }
        }
      } catch (e) {
        if (!answer) { bot.remove(); addBubble('cw__bubble--error', 'Connection lost. Please try again.'); }
      } finally {
        if (caret.parentNode) caret.remove();
        if (answer) history.push({ role: 'assistant', content: answer });
        setBusy(false);
        input.focus();
      }
    }

    trigger.addEventListener('click', function () { panel.hidden ? open() : close(); });
    closeBtn.addEventListener('click', close);
    form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value); });
    root.querySelectorAll('[data-cw-starter]').forEach(function (btn) {
      btn.addEventListener('click', function () { ask(btn.getAttribute('data-cw-starter') || ''); });
    });
  })();
</script>
