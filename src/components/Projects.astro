---
import projects from '../data/projects.json';
import ComparisonCard from './ComparisonCard.astro';

const stillClasses = ['still-1','still-2','still-3','still-4','still-5','still-6','still-3','still-1'];
---
<section id="work" class="section section--dark grain" aria-label="Selected work">
  <div class="wrap">
    <div class="section-head no-border">
      <div>
        <span class="eyebrow">Selected Work</span>
        <h2 class="section-title">Twenty years of<br/>solutions delivered.</h2>
      </div>
      <span class="section-head__count">08 Projects · 2016—2026</span>
    </div>

    <div class="rainbow-rule" data-rainbow aria-hidden="true">
      <span style="flex:8;background:#5fb3e8"></span>
      <span style="flex:3;background:#0a0a0a"></span>
      <span style="flex:5;background:#222a45"></span>
      <span style="flex:4;background:#3a8a4d"></span>
      <span style="flex:6;background:var(--amber)"></span>
      <span style="flex:7;background:#d94a3d"></span>
      <span style="flex:3;background:#1a2540"></span>
      <span style="flex:9;background:#5fb3e8"></span>
      <span style="flex:4;background:#0a0a0a"></span>
      <span style="flex:5;background:#2f4a3a"></span>
      <span style="flex:5;background:var(--amber)"></span>
      <span style="flex:4;background:#f0c64a"></span>
      <span style="flex:6;background:#d94a3d"></span>
      <span style="flex:4;background:#6b3a6e"></span>
      <span style="flex:7;background:#5fb3e8"></span>
    </div>

    <div class="work-grid">
      {projects.map((project, i) => {
        const idx = String(i + 1).padStart(2, '0');
        const spanClass = `span-${project.span}`;
        const stillClass = stillClasses[i] || 'still-1';
        const hasThumbnail = !!project.thumbnail;
        // Each non-coming-soon project links to its own case-study page.
        const href = project.coming_soon ? null : `/work/${project.id}`;
        const label = `${project.client} — ${project.type}${project.coming_soon ? ', Coming Soon' : ', ' + project.year}`;
        if (project.comparison) {
          return <ComparisonCard project={project} index={idx} />;
        }
        return (
          <a
            class={`work-card ${spanClass}`}
            href={href ?? undefined}
            data-coming-soon={project.coming_soon ? 'true' : undefined}
            aria-label={label}
          >
            <div
              class={`work-card__still ${stillClass}`}
              style={hasThumbnail ? `background-image:url('${project.thumbnail}');background-size:contain;background-repeat:no-repeat;background-position:center` : undefined}
            >
              {!hasThumbnail && (
                <div class="work-card__placeholder">[ video still ]</div>
              )}
            </div>
            <div class="work-card__veil"></div>
            <span class="work-card__index">{idx}</span>
            <span class="work-card__corner"></span>
            {project.coming_soon && <span class="work-card__badge">Coming Soon</span>}
            <div class="work-card__meta">
              <div>
                <div class="work-card__client">{project.name}</div>
                <div class="work-card__type">{project.type}</div>
                {project.disciplines && <div class="work-card__disciplines">{project.disciplines}</div>}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-coming-soon]').forEach((card) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const badge = card.querySelector('.work-card__badge') as HTMLElement | null;
      if (!badge) return;
      badge.classList.remove('is-flashing');
      // Force reflow so re-clicking re-triggers
      void badge.offsetWidth;
      badge.classList.add('is-flashing');
      badge.addEventListener('animationend', () => badge.classList.remove('is-flashing'), { once: true });
    });
  });
</script>
