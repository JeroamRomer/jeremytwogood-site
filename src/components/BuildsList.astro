---
import aiBuilds from '../data/ai-builds.json';
import RomeBrain from './RomeBrain.astro';
import imageSizes from '../data/build-image-sizes.json';
const shotSizes: Record<string, { width: number; height: number }> = imageSizes;
import '../styles/build-previews.css';

interface Props { level?: 'h2' | 'h3' }
const { level = 'h3' } = Astro.props;
const Heading = level;
const statusLabel = (status: string) => ({ live: 'Live', internal: 'Internal · Rome Brone', beta: 'Beta', 'in-dev': 'Private beta' }[status] ?? status);
const statusClass = (status: string) => status === 'live' ? 'build-card__status is-live' : 'build-card__status';
---
<div class="builds-grid">
  {aiBuilds.map((build, index) => {
    const hasShot = Boolean(build.shot_images?.length);
    const spanStyle = build.span === 2 ? 'grid-column:span 2' : undefined;
    return (
      <article class="build-card" style={spanStyle} id={`build-${build.id}`}>
        {hasShot && (
          <div class={`build-card__shot ${build.shot_class ?? ''}`} aria-hidden="true">
            {build.id === 'production-intelligence' ? <RomeBrain /> : build.shot_images.map((src, shotIndex) => (
              <img src={src} width={shotSizes[src]?.width} height={shotSizes[src]?.height} alt={build.shot_alts?.[shotIndex] || build.name} loading="lazy" decoding="async" />
            ))}
          </div>
        )}
        {build.live_url && <a class="build-card__url" href={build.live_url} target="_blank" rel="noopener">{build.live_url.replace('https://', '')}</a>}
        <div class="build-card__top"><Heading class="build-card__name">{build.name}</Heading></div>
        <p class="build-card__desc">{build.description}</p>
        <div class="build-card__bottom">
          <span class="build-card__index">{String(index + 1).padStart(2, '0')}</span>
          <span class={statusClass(build.status)}>{statusLabel(build.status)}</span>
        </div>
        <div class="build-card__stack">{build.tech_stack.map((tech) => <span class="tag">{tech}</span>)}</div>
        <div class="build-card__cta">
          {build.live_url
            ? <a class="build-card__launch" href={build.live_url} target="_blank" rel="noopener">Try it out <span class="arrow">↗</span></a>
            : build.status === 'in-dev' ? <span class="build-card__coming-soon">Coming soon</span> : null}
        </div>
      </article>
    );
  })}
</div>

<script>
  import '../scripts/build-card-previews';
</script>

<style>
  .builds-grid{ display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:20px; }
  .build-card{ position:relative; min-width:0; min-height:320px; padding:32px 28px 28px; display:flex; flex-direction:column; overflow:hidden; background:#fff; border:1px solid #dcd6cb; transition:border-color .2s ease; }
  .build-card:hover{ border-color:var(--mango); }
  .build-card__top{ display:flex; gap:16px; margin-bottom:14px; }
  .build-card__name{ margin:0; color:#1a1a1a; font-family:var(--font-display); font-weight:600; font-size:22px; line-height:1.15; }
  .build-card__desc{ max-width:46ch; margin:0 0 22px; color:#34322d; font-size:15px; line-height:1.55; }
  .build-card__bottom{ display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-bottom:12px; border-bottom:1px dashed #dcd6cb; }
  .build-card__index{ color:#77736c; font-family:var(--font-readout); font-size:10px; letter-spacing:.12em; }
  .build-card__status{ display:inline-flex; align-items:center; gap:8px; color:#6b6b63; font-family:var(--font-readout); font-size:10px; letter-spacing:.18em; text-transform:uppercase; white-space:nowrap; }
  .build-card__status.is-live{ color:var(--mango); }
  .build-card__status.is-live::before{ content:""; width:6px; height:6px; border-radius:50%; background:var(--mango); }
  .build-card__stack{ display:flex; flex-wrap:wrap; gap:6px; padding-top:18px; }
  .tag{ padding:4px 9px; border:1px solid #dcd6cb; border-radius:2px; color:#6b6b63; font-family:var(--font-readout); font-size:10.5px; letter-spacing:.06em; }
  .build-card__url{ position:absolute; top:32px; right:28px; max-width:48%; overflow:hidden; color:#8a867d; font-family:var(--font-readout); font-size:10px; letter-spacing:.1em; text-overflow:ellipsis; white-space:nowrap; }
  .build-card__cta{ position:relative; z-index:3; min-height:36px; padding-top:16px; }
  .build-card__launch{ display:inline-flex; align-items:center; gap:8px; min-height:36px; padding:0 14px; border:1px solid var(--mango); background:var(--mango); color:var(--mango-ink); font-family:var(--font-ui); font-weight:600; font-size:13px; line-height:1; }
  .build-card__launch:hover{ border-color:var(--mango-hover); background:var(--mango-hover); }
  .build-card__coming-soon{ color:#8a867d; font-family:var(--font-readout); font-size:10px; letter-spacing:.1em; text-transform:uppercase; }
  .build-card__shot{ position:absolute; inset:0; z-index:2; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; background:rgba(244,241,236,.94); transition:opacity .35s ease; }
  .build-card__shot--web{ padding:18px; background:linear-gradient(135deg, rgba(244,241,236,.97), rgba(244,241,236,.88)); }
  .build-card__shot--web img{ width:100%; max-height:100%; border-radius:10px; object-fit:cover; object-position:top; }
  .build-card__shot--phones{ gap:14px; padding:24px; background:linear-gradient(135deg, rgba(244,241,236,.97), rgba(244,241,236,.88)); }
  .build-card__shot--phones img{ width:auto; height:100%; max-width:46%; max-height:100%; border-radius:18px; object-fit:cover; }
  .build-card__shot--four{ gap:8px; padding:16px; }
  .build-card__shot--four img{ width:auto; height:auto; max-width:23%; max-height:80%; border-radius:12px; object-fit:contain; }
  .build-card__shot--board{ display:grid; grid-template-columns:.9fr 1.3fr 1.3fr; grid-template-rows:208px 148px 280px; grid-template-areas:"icon script board" "transcript script board" "transcript strip strip"; gap:16px; padding:24px; background:var(--text); align-items:stretch; }
  .build-card__shot--board img{ width:100%; height:100%; min-width:0; min-height:0; max-height:100%; object-fit:contain; border-radius:14px; background:#121417; }
  .build-card__shot--board img:nth-child(1){ grid-area:icon; width:208px; height:208px; max-width:100%; justify-self:center; align-self:center; background:none; }
  .build-card__shot--board img:nth-child(2){ grid-area:transcript; object-position:center top; background:#26292f; }
  .build-card__shot--board img:nth-child(3){ grid-area:script; padding:18px; object-position:center; }
  .build-card__shot--board img:nth-child(4){ grid-area:board; padding:18px; object-fit:cover; object-position:left top; }
  .build-card__shot--board img:nth-child(5){ grid-area:strip; padding:18px; object-fit:cover; object-position:center top; }
  .build-card:has(.build-card__shot--board){ min-height:320px; }
  @media (max-width:720px){
    .build-card:has(.build-card__shot--board){ min-height:280px; }
    .build-card.is-active:has(.build-card__shot--board){ padding:0; }
    .build-card.is-active:has(.build-card__shot--board) > :not(.build-card__shot){ display:none; }
    .build-card__shot--board{ position:relative; inset:auto; grid-template-columns:.95fr 1.05fr; grid-template-rows:auto auto auto; grid-template-areas:"icon script" "transcript board" "transcript strip"; gap:10px; padding:14px; align-items:start; align-content:start; }
    .build-card__shot--board img{ height:auto; max-height:none; }
    .build-card__shot--board img:nth-child(1){ width:132px; height:auto; }
    .build-card__shot--board img:nth-child(3), .build-card__shot--board img:nth-child(4), .build-card__shot--board img:nth-child(5){ padding:10px; object-fit:contain; }
  }
  .build-card__shot--icon{ inset:24px 24px auto auto; width:80px; height:80px; opacity:.35; background:none; }
  .build-card__shot--icon img{ width:100%; height:auto; mix-blend-mode:multiply; }
  .build-card:hover .build-card__shot:not(.build-card__shot--icon), .build-card.is-active .build-card__shot:not(.build-card__shot--icon){ opacity:1; }
  .build-card:hover .build-card__shot--icon{ opacity:1; }
  @media (max-width:900px){ .builds-grid{ grid-template-columns:1fr; } .build-card[style*="span 2"]{ grid-column:span 1 !important; } }
  @media (max-width:720px){ .build-card{ min-height:280px; } .build-card__shot:not(.build-card__shot--icon){ display:none; } .build-card.is-active .build-card__shot:not(.build-card__shot--icon){ display:flex; } .build-card__shot--icon{ inset:16px 16px auto auto; width:54px; height:54px; opacity:1; } }
  @media (max-width:720px){ .build-card.is-active .build-card__shot.build-card__shot--board{ display:grid; } }
  @media (max-width:640px){ .build-card__url{ position:static; display:block; max-width:100%; margin:0 0 12px; text-align:right; } }
  @media (prefers-reduced-motion: reduce){ .build-card, .build-card__shot{ transition:none; } }
</style>
