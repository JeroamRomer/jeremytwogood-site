---
import profile from '../data/profile.json';
const social = profile.social as Record<string, string>;
---
<section id="contact" class="contact" aria-label="Contact Jeremy Twogood">
  <div class="contact__inner">
    <div>
      <h2>Let's make<br/>something<span class="amber">.</span></h2>
      <p class="contact__line">Available for broadcast, corporate, and documentary projects. Edits, productions, and the occasional AI build.</p>
    </div>
    <div class="contact__links">
      <div class="contact__row">
        <span class="label">Email</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
      <div class="contact__row">
        <span class="label">LinkedIn</span>
        <a href={social.linkedin} target="_blank" rel="noopener">/in/jeremy-twogood</a>
      </div>
      <div class="contact__row">
        <span class="label">SoundCloud</span>
        <a href="https://soundcloud.com/j-twogood/tracks" target="_blank" rel="noopener">/j-twogood</a>
      </div>
      <div class="contact__row">
        <span class="label">Reel</span>
        <a href="/reel">jeremytwogood.com/reel</a>
      </div>
    </div>
  </div>
</section>
