---
interface Props {
  project: {
    name: string;
    type: string;
    disciplines: string;
    year: number | string;
    thumbnail: string;
    graded_src: string;
    ungraded_src: string;
  };
  index: string;
}
const { project, index } = Astro.props;
const uid = `cc-${Math.random().toString(36).slice(2, 7)}`;
---

<div
  id={uid}
  class="work-card span-6 comparison-card"
  role="img"
  aria-label={`${project.name} — ${project.type}, ${project.year}. Drag to compare colour grades.`}
>
  <!-- Bottom layer: graded (always full width, always visible behind) -->
  <video class="cc-video cc-video--graded" src={project.graded_src} loop muted playsinline preload="none"></video>

  <!-- Top layer: ungraded, clips from right — drag right reveals more graded underneath -->
  <video class="cc-video cc-video--ungraded" src={project.ungraded_src} loop muted playsinline preload="none"></video>

  <!-- Slider overlay: vertical line + handle -->
  <div class="cc-slider" aria-hidden="true">
    <div class="cc-slider__line">
      <div class="cc-slider__handle">⇔</div>
    </div>
    <div class="cc-slide-hint">Slide me!</div>
  </div>

  <!-- Static thumbnail — sits on top, fades out on hover -->
  <img class="cc-thumb" src={project.thumbnail} alt="" aria-hidden="true" />

  <!-- Veil gradient for meta readability -->
  <div class="work-card__veil"></div>

  <!-- Index + corner accent (matches existing cards) -->
  <span class="work-card__index">{index}</span>
  <span class="work-card__corner"></span>

  <!-- Meta overlay -->
  <div class="work-card__meta">
    <div>
      <div class="work-card__client">{project.name}</div>
      <div class="work-card__type">{project.type}</div>
      <div class="cc-disciplines">{project.disciplines}</div>
    </div>
    <div class="cc-grade-label">Colour Grading<br/>Example</div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap');
  /* Card cursor */
  .comparison-card {
    cursor: ew-resize;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ── Videos ── */
  .cc-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ungraded sits on top — clip-path set directly by JS */
  .cc-video--ungraded {}

  /* Touch-active state mirrors :hover for devices without pointer */
  .comparison-card.is-active .cc-thumb { opacity: 0; }
  .comparison-card.is-active .cc-slider { opacity: 1; }
  .comparison-card.is-active .cc-disciplines { opacity: 1; transform: translateY(0); }

  /* ── Thumbnail (on top, fades out on hover) ── */
  .cc-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 1;
    transition: opacity 300ms ease;
    z-index: 3;
    filter: grayscale(0.15) contrast(1.05);
    pointer-events: none;
  }

  .comparison-card:hover .cc-thumb {
    opacity: 0;
  }

  /* ── Slider overlay ── */
  .cc-slider {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 200ms ease;
    z-index: 4;
    pointer-events: none;
  }

  .comparison-card:hover .cc-slider {
    opacity: 1;
  }

  /* The line position is set directly by JS */
  .cc-slider__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: rgba(255, 255, 255, 0.8);
    transform: translateX(-50%);
  }

  .cc-slider__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 14px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* ── Colour grading label (replaces year) ── */
  .cc-grade-label {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--amber);
    text-align: right;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(8px);
    transition: transform .35s ease .1s, opacity .35s ease .1s;
  }
  .comparison-card:hover .cc-grade-label,
  .comparison-card.is-active .cc-grade-label {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── "Slide me!" hint ──
     Handle center is at (50%, 50%) of the card.
     Hint sits 70px right and 85px above that — giving a clean ~45° diagonal.
  ── */
  .cc-slide-hint {
    position: absolute;
    top: calc(50% - 85px);
    left: calc(50% + 70px);
    font-family: 'Caveat', cursive;
    font-size: 44px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    pointer-events: none;
    text-shadow: 0 1px 8px rgba(0,0,0,.55);
    line-height: 1;
  }
  /* Line from left edge of text, angled down-left at ~45° toward handle */
  .cc-slide-hint::before {
    content: '';
    position: absolute;
    right: calc(100% + 6px);
    top: 50%;
    width: 72px;
    height: 1.5px;
    background: rgba(255,255,255,0.6);
    transform-origin: right center;
    transform: rotate(45deg);
  }
  /* hide after user has dragged once */
  .cc-slide-hint.is-used { display: none; }
  /* hide on mobile — touch users don't need the prompt */
  @media (max-width: 720px) { .cc-slide-hint { display: none; } }

  /* ── Disciplines sub-line (extra meta row) ── */
  .cc-disciplines {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(244, 241, 236, 0.35);
    margin-top: 4px;
    opacity: 0;
    transform: translateY(8px);
    transition: transform 0.35s ease 0.1s, opacity 0.35s ease 0.1s;
  }

  .comparison-card:hover .cc-disciplines {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script define:vars={{ uid }}>
  const card = document.getElementById(uid);
  if (!card) return;

  const gradedVideo = card.querySelector('.cc-video--graded');
  const ungradedVideo = card.querySelector('.cc-video--ungraded');
  const sliderLine = card.querySelector('.cc-slider__line');
  const slideHint = card.querySelector('.cc-slide-hint');
  let dragging = false;
  let syncInterval = null;

  function setPct(pct) {
    const clamped = Math.min(100, Math.max(0, pct));
    sliderLine.style.left = clamped + '%';
    ungradedVideo.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
  }

  // Keep ungraded locked to graded's playhead — runs every 500ms while playing
  function syncVideos() {
    if (Math.abs(gradedVideo.currentTime - ungradedVideo.currentTime) > 0.1) {
      ungradedVideo.currentTime = gradedVideo.currentTime;
    }
  }

  // Initialise at 50%
  setPct(50);

  // Detect touch-primary devices (no fine pointer)
  const isTouchDevice = () => window.matchMedia('(hover: none)').matches;

  function startVideos() {
    gradedVideo.currentTime = 0;
    ungradedVideo.currentTime = 0;
    gradedVideo.play().catch(() => {});
    ungradedVideo.play().catch(() => {});
    if (!syncInterval) syncInterval = setInterval(syncVideos, 500);
  }

  function stopVideos() {
    clearInterval(syncInterval);
    syncInterval = null;
    gradedVideo.pause();
    ungradedVideo.pause();
    setPct(50);
  }

  // Play both videos on hover, pause + reset on leave (mouse/trackpad)
  card.addEventListener('mouseenter', () => {
    if (!isTouchDevice()) startVideos();
  });

  card.addEventListener('mouseleave', () => {
    if (!isTouchDevice()) stopVideos();
  });

  // On touch: first pointerdown starts videos and shows slider
  // Subsequent pointerdowns just drag as normal
  card.addEventListener('pointerdown', (e) => {
    dragging = true;
    card.setPointerCapture(e.pointerId);

    if (isTouchDevice() && gradedVideo.paused) {
      startVideos();
      card.classList.add('is-active');
    }
  });

  // Pause + reset when card scrolls out of view on touch devices
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting && isTouchDevice()) {
          stopVideos();
          card.classList.remove('is-active');
        }
      });
    }, { threshold: 0.1 });
    observer.observe(card);
  }

  card.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const rect = card.getBoundingClientRect();
    setPct((e.clientX - rect.left) / rect.width * 100);
    // Hide hint once user has actually dragged
    if (slideHint) slideHint.classList.add('is-used');
  });

  card.addEventListener('pointerup', () => { dragging = false; });
  card.addEventListener('pointercancel', () => { dragging = false; });
</script>
