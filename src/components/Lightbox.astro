---
// Single on-site video modal. Triggered by any element with [data-video-embed].
---
<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Video player" hidden>
  <div class="lightbox__backdrop" data-lightbox-close></div>
  <div class="lightbox__dialog">
    <button class="lightbox__close" id="lightbox-close" aria-label="Close video" data-lightbox-close>&times;</button>
    <div class="lightbox__frame">
      <iframe
        id="lightbox-iframe"
        title="Video player"
        allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
        allowfullscreen
        src="about:blank"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .lightbox{ position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:clamp(12px, 5vw, 64px); }
  .lightbox[hidden]{ display:none; }
  .lightbox__backdrop{ position:absolute; inset:0; background:rgba(8, 8, 10, .92); }
  .lightbox__dialog{ position:relative; width:min(1100px, 100%); border:1px solid var(--hair-strong); background:var(--panel); }
  .lightbox__dialog::before{ content:"Program"; display:flex; align-items:center; height:var(--pane-head-h); padding:0 14px; background:var(--panel-head); border-bottom:1px solid var(--hair); font:600 12px/1 var(--font-ui); letter-spacing:.02em; text-transform:uppercase; color:var(--muted); }
  .lightbox__frame{ position:relative; width:100%; aspect-ratio:16 / 9; background:#000; }
  .lightbox__frame iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }
  .lightbox__close{ position:absolute; top:0; right:0; width:var(--pane-head-h); height:var(--pane-head-h); display:grid; place-items:center; padding:0; font-size:22px; line-height:1; color:var(--muted); background:none; border:0; border-left:1px solid var(--hair); cursor:pointer; }
  .lightbox__close:hover{ color:var(--text); background:var(--lane); }
  .lightbox__close:focus-visible{ outline:2px solid var(--mango); outline-offset:-2px; }
</style>

<script>
  (function () {
    var lb = document.getElementById('lightbox');
    var frame = document.getElementById('lightbox-iframe') as HTMLIFrameElement | null;
    var closeBtn = document.getElementById('lightbox-close');
    if (!lb || !frame || !closeBtn) return;
    var lastFocused: HTMLElement | null = null;

    function open(embed: string, label: string) {
      lastFocused = document.activeElement as HTMLElement;
      frame!.src = embed;
      lb!.setAttribute('aria-label', label || 'Video player');
      lb!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      closeBtn!.focus();
      document.addEventListener('keydown', onKey);
    }

    function close() {
      lb!.hidden = true;
      frame!.src = 'about:blank'; // stops playback + audio
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') { close(); return; }
      if (e.key === 'Tab') { e.preventDefault(); closeBtn!.focus(); } // trap focus in modal chrome
    }

    lb.querySelectorAll('[data-lightbox-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });

    document.querySelectorAll('[data-video-embed]').forEach(function (card) {
      card.addEventListener('click', function (e) {
        var me = e as MouseEvent;
        // let cmd/ctrl/shift/middle clicks open a new tab as normal
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey || me.button === 1) return;
        e.preventDefault();
        var embed = card.getAttribute('data-video-embed');
        var label = card.getAttribute('data-video-title') || 'Video player';
        if (embed) open(embed, label);
      });
    });
  })();
</script>
