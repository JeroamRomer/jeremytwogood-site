---
// Site-wide panel bar: the reel mark + wordmark as the sequence tab, section tabs, and status readouts.
const onHome = Astro.url.pathname === '/';
const base = onHome ? '' : '/';
const tabs = [
  { id: 'work', label: 'Work' },
  { id: 'about', label: 'About' },
  { id: 'builds', label: 'Builds' },
  { id: 'sound', label: 'Sound' },
  { id: 'contact', label: 'Contact' },
];
---
<header class="bar" id="nav">
  <a class="bar__brand" href={onHome ? '#top' : '/'} aria-label="Jeremy Twogood, home">
    <span class="bar__lockup">
      <span class="bar__mark-wrap">
        <svg class="bar__mark bar__mark-roll" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="12" cy="12" r="2.6" class="bar__hub" />
          <circle cx="12" cy="5" r="2" fill="currentColor" />
          <circle cx="19" cy="12" r="2" fill="currentColor" />
          <circle cx="12" cy="19" r="2" fill="currentColor" />
          <circle cx="5" cy="12" r="2" fill="currentColor" />
        </svg>
      </span>
      <span class="bar__name">Jeremy Twogood<span class="bar__dot">.</span></span>
      <span class="bar__rollout" aria-hidden="true"></span>
    </span>
  </a>
  <nav class="bar__tabs" aria-label="Primary">
    {tabs.map((t) => (
      <a class="bar__tab" href={`${base}#${t.id}`} data-tab={t.id}>{t.label}</a>
    ))}
  </nav>
  <p class="bar__status">
    <span class="readout">EST · GMT−5</span>
    <span class="bar__avail">Available · 2026</span>
  </p>
</header>

<style>
  .bar{
    position:sticky; top:0; z-index:50;
    display:flex; align-items:stretch; height:var(--bar-h);
    background:rgba(28,28,31,.78); border-bottom:1px solid rgba(59,59,67,.72);
    backdrop-filter:blur(14px) saturate(1.12); -webkit-backdrop-filter:blur(14px) saturate(1.12);
    font-family:var(--font-ui); color:var(--text);
  }
  .bar__brand{
    display:flex; align-items:center; gap:10px; padding:0 18px;
    border-right:1px solid var(--hair); white-space:nowrap;
    position:relative;
  }
  .bar__lockup{ position:relative; display:flex; align-items:center; gap:10px; }
  .bar__rollout{ position:absolute; left:10px; right:0; bottom:1px; height:2px; background:currentColor; transform:scaleX(0); transform-origin:left center; animation:bar-reel-line 1.6s ease-in-out both; pointer-events:none; }
  .bar__brand:hover .bar__rollout, .bar__brand:focus-visible .bar__rollout{ animation:bar-reel-line-loop 2.8s ease-in-out infinite; }
  .bar__mark-wrap{ display:grid; place-items:center; flex:0 0 20px; }
  .bar__mark-roll{ transform-origin:center; animation:bar-reel-roll 1.6s ease-in-out; }
  .bar__brand:hover .bar__mark-roll, .bar__brand:focus-visible .bar__mark-roll{ animation:bar-reel-roll-loop 2.8s ease-in-out infinite; }
  @keyframes bar-reel-line{ from{transform:scaleX(0)} to{transform:scaleX(1)} }
  @keyframes bar-reel-line-loop{ 0%,100%{transform:scaleX(1)} 50%{transform:scaleX(0)} }
  @keyframes bar-reel-roll{ from{transform:rotate(120deg)} to{transform:rotate(0)} }
  @keyframes bar-reel-roll-loop{ 0%,100%{transform:rotate(0)} 50%{transform:rotate(120deg)} }
  @media (prefers-reduced-motion: reduce){
    .bar__rollout{ animation:none; transform:scaleX(1); }
    .bar__mark-roll{ animation:none; }
  }
  .bar__mark{ width:20px; height:20px; color:var(--text); }
  .bar__hub{ fill:var(--mango); }
  .bar__name{ font-family:var(--font-display); font-variation-settings:'wdth' 112; font-weight:700; font-size:15px; }
  .bar__dot{ color:var(--mango); }
  .bar__tabs{ display:flex; }
  .bar__tab{
    display:flex; align-items:center; padding:0 16px;
    border-right:1px solid var(--hair); color:var(--muted); font-size:13px; font-weight:500;
    transition:color .15s, background-color .15s;
  }
  .bar__tab:hover{ color:var(--text); background:var(--lane); }
  .bar__tab.is-active{ color:var(--text); box-shadow:inset 0 -2px 0 var(--mango); }
  .bar__status{ margin:0 0 0 auto; display:flex; align-items:center; gap:20px; padding:0 18px; padding-right:calc(18px + var(--chat-trigger-w)); font-size:13px; color:var(--muted); white-space:nowrap; }
  .bar__avail{ color:var(--text); font-weight:500; }

  /* 761-1100px: brand + tabs + status no longer all fit on one nowrap row at
     the full trigger width, so shed content in the order the ruling allows:
     the EST readout first (was already hidden below 900; now earlier), then
     the reservation shrinks to match the trigger's short "Ask" label (see
     ChatWidget.astro's matching breakpoint), then in the tightest band the
     availability line itself steps aside (it still shows in the Contact bin). */
  @media (max-width: 1100px){
    .bar__status .readout{ display:none; }
    .bar__status{ padding-right:calc(14px + var(--chat-trigger-w-mobile)); gap:14px; }
  }
  @media (max-width: 840px){ .bar__avail{ display:none; } }
  @media (max-width: 760px){
    .bar{ height:auto; flex-wrap:wrap; }
    .bar__brand{ flex:1 1 auto; height:var(--bar-h); border-right:0; padding:0 14px; padding-right:calc(14px + var(--chat-trigger-w-mobile)); }
    .bar__status{ display:none; }
    .bar__tabs{ flex:1 1 100%; border-top:1px solid var(--hair); }
    .bar__tab{ flex:1 1 0; justify-content:center; padding:0 4px; min-height:40px; }
    .bar__tab:last-child{ border-right:0; }
  }
</style>

<script>
  // Active tab: the section crossing the upper-middle of the viewport.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.bar__tab'));
  const byId = new Map(tabs.map((t) => [t.dataset.tab, t]));
  if ('IntersectionObserver' in window && byId.size) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        tabs.forEach((t) => { t.classList.remove('is-active'); t.removeAttribute('aria-current'); });
        const tab = byId.get(e.target.id);
        if (tab) { tab.classList.add('is-active'); tab.setAttribute('aria-current', 'true'); }
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    byId.forEach((_, id) => { const s = id && document.getElementById(id); if (s) io.observe(s); });
  }
</script>
