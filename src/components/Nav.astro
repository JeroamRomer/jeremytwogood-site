---
<nav class="nav is-light" id="nav" aria-label="Primary">
  <a class="nav__brand" href="#top" aria-label="Jeremy Twogood — home">
    <span class="nav__brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--amber)">
        <g class="reel">
          <circle cx="12" cy="12" r="11" style="stroke: currentColor"/>
          <circle cx="12" cy="12" r="2.6" fill="var(--amber)" stroke="none"/>
          <circle cx="12" cy="5" r="2" fill="currentColor" stroke="none"/>
          <circle cx="19" cy="12" r="2" fill="currentColor" stroke="none"/>
          <circle cx="12" cy="19" r="2" fill="currentColor" stroke="none"/>
          <circle cx="5" cy="12" r="2" fill="currentColor" stroke="none"/>
        </g>
      </svg>
    </span>
    <span class="nav__brand-name">Jerem<span class="gap-y">y</span> Two<span class="gap-g">g</span>ood<span class="dot">.</span></span>
  </a>
  <button class="nav__burger" id="nav-burger" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
  <div class="nav__links">
    <a href="#work">Work</a>
    <a href="#about">About</a>
    <a href="#builds">Builds</a>
    <a href="#sound">Sound</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<script>
  // Nav: light/dark adaptive
  (function(){
    var nav = document.getElementById('nav');
    if (!nav) return;
    var sections = document.querySelectorAll('section.section, header.section');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          var isLight = e.target.classList.contains('section--light');
          nav.classList.toggle('is-light', isLight);
        }
      });
    }, { rootMargin: '-50px 0px -85% 0px', threshold: 0 });
    sections.forEach(function(s){ io.observe(s); });

    // active link
    var links = document.querySelectorAll('.nav__links a');
    var byHash = {};
    links.forEach(function(a){ byHash[a.getAttribute('href')] = a; });
    var io2 = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          var id = '#' + e.target.id;
          links.forEach(function(a){ a.classList.remove('is-active'); });
          if(byHash[id]) byHash[id].classList.add('is-active');
        }
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    document.querySelectorAll('section[id]').forEach(function(s){ io2.observe(s); });

    // Burger menu
    var burger = document.getElementById('nav-burger');
    if(burger){
      burger.addEventListener('click', function(){
        var open = nav.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      nav.querySelectorAll('.nav__links a').forEach(function(a){
        a.addEventListener('click', function(){
          nav.classList.remove('is-open');
          burger.setAttribute('aria-expanded','false');
        });
      });
    }

    // Underline gap measurement — y and g descenders
    (function() {
      function measureGaps() {
        var name = document.querySelector('.nav__brand-name');
        if (!name) return;
        var gapY = name.querySelector('.gap-y');
        var gapG = name.querySelector('.gap-g');
        if (!gapY || !gapG) return;
        var nr = name.getBoundingClientRect();
        var overhang = 15; // matches left:-15px on ::after
        var totalW = nr.width + overhang;
        function pct(el, side) {
          var r = el.getBoundingClientRect();
          var px = (side === 'left' ? r.left : r.right) - nr.left + overhang;
          return (Math.max(0, px) / totalW * 100).toFixed(1) + '%';
        }
        name.style.setProperty('--ys', pct(gapY, 'left'));
        name.style.setProperty('--ye', pct(gapY, 'right'));
        name.style.setProperty('--gs', pct(gapG, 'left'));
        name.style.setProperty('--ge', pct(gapG, 'right'));
      }
      document.fonts.ready.then(measureGaps);
      window.addEventListener('resize', measureGaps);
    })();

    // Rainbow rule: animate in when first visible
    document.querySelectorAll('[data-rainbow]').forEach(function(r){
      var rio = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting){
            r.classList.add('is-on');
            rio.unobserve(r);
          }
        });
      }, { threshold: 0.4 });
      rio.observe(r);
    });
  })();
</script>
