---
import aiBuilds from '../data/ai-builds.json';

function statusLabel(status: string) {
  if (status === 'live') return 'Live';
  if (status === 'internal') return 'Internal · Rome Brone';
  if (status === 'beta') return 'Beta';
  if (status === 'in-dev') return 'Private Beta';
  return status;
}

function statusClass(status: string) {
  return status === 'live' ? 'build-card__status is-live' : 'build-card__status';
}
---
<section id="builds" class="section section--light" style="border-top:1px solid var(--light-rule)" aria-label="AI and software builds">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">AI Builds</span>
        <h2 class="section-title">Software that<br/>removes the busywork.</h2>
      </div>
      <span class="section-head__count">05 Shipped · /ai-builds</span>
    </div>

    <div class="builds-grid">
      {aiBuilds.map((build, i) => {
        const idx = String(i + 1).padStart(2, '0');
        const hasShot = build.shot_class && build.shot_images && build.shot_images.length > 0;
        const spanStyle = build.span === 2 ? 'grid-column:span 2' : undefined;
        return (
          <article class="build-card" style={spanStyle} id={`build-${build.id}`}>
            {hasShot && (
              <div class={`build-card__shot ${build.shot_class}`}>
                {build.shot_images.map((src, j) => (
                  <img src={src} alt={build.shot_alts[j] || build.name} loading="lazy" />
                ))}
              </div>
            )}
            {build.live_url && (
              <a class="build-card__url" href={build.live_url} target="_blank" rel="noopener">
                {build.live_url.replace('https://', '')}
              </a>
            )}
            <div class="build-card__top">
              <h3 class="build-card__name">{build.name}</h3>
            </div>
            <p class="build-card__desc">{build.description}</p>
            <div class="build-card__bottom">
              <div class="build-card__index">{idx}</div>
              <span class={statusClass(build.status)}>{statusLabel(build.status)}</span>
            </div>
            <div class="build-card__stack">
              {build.tech_stack.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
            <div class="build-card__cta">
              {build.live_url
                ? <a class="build-card__launch" href={build.live_url} target="_blank" rel="noopener">Try it out <span class="arrow">↗</span></a>
                : build.status === 'in-dev'
                  ? <span class="build-card__coming-soon">Coming Soon</span>
                  : null
              }
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
